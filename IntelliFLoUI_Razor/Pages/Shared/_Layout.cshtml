@using IntelliFloCore.Ingestion
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - IntelliFlo</title>
    <script src="~/js/pace.min.js"></script>
    <script src="~/js/modernizr-2.8.3.min.js"></script>
    <script src="~/js/jquery-3.4.1.js"></script>
    <script src="~/js/moment.js"></script>
    <script src="~/js/daterangepicker.js"></script>
    <link rel="stylesheet" href="~/css/daterangepicker.css">
    <link rel="stylesheet" href="~/css/bundle.css">
    <style>

        .fullscreen {
            position: fixed;
            height: 100%;
            width: 100%;
            background-color: #1e2b37;
            color: white;
            z-index: 1000;
        }

        .center {
            position: absolute;
            width: 500px;
            text-align: center;
            height: 50px;
            top: 50%;
            left: 50%;
            margin-left: -250px; /* margin is -0.5 * dimension */
            margin-top: -150px;
            font-size: 80px;
        }

        .query-form {
            padding: 20px;
            border-bottom: 1px solid #ddd; /* Add border between query and results */
        }

        .form-control {
            border-radius: 4px;
        }

        .btn-search {
            background-color: #007bff;
            border-color: #007bff;
            color: #fff;
            border-radius: 4px;
        }

        .query-results {
            padding: 20px;
            border-radius: 0 0 8px 8px; /* Rounded corners only on bottom */
        }

            .query-results th {
                background-color: #007bff; /* Header background color */
                color: #fff; /* Header text color */
            }

        .datepicker {
            z-index: 1051 !important;
        }

        .custom-range-wrapper {
            display: flex;
            align-items: center;
        }

        .custom-range-inputs {
            display: none;
            margin-left: 10px;
            height: 50px;
        }

            .custom-range-inputs input {
                width: 500px;
                max-width: 500px;
            }

        #ele b {
            color: #6e9fa5 !important;
        }

        .visualization {
            width: 100% !important;
            height: 250px !important;
        }

        .pre-footer {
            bottom: 20px;
            right: 100px;
            position: absolute;
        }

        .footer {
            position: fixed;
            bottom: 0px;
            width: 100%;
            padding: 15px 0;
            background-color: #2f3c48;
        }

            .footer .container {
                padding: 0px 20px;
                text-align: right;
            }
    </style>
</head>
<body>
    <div class="fullscreen">
        <div class="center"><span id="ele"></span></div>
        <p class="pre-footer">Handcrafted with ❤️ by <a class="text-light" href="mailto:princeshan031@gmail.com"><b>Prince Shankushal</b></a></p>
    </div>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/IntelliFlo/iui">Intelli<strong class="text-warning">Flo</strong></a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li><a class="nav-link" href="/IntelliFlo/iui">Search</a></li>
                </ul>
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#">About</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
    </div>
    <footer class="footer">
        <div class="container">
            <span class="text-light">Handcrafted with ❤️ by <a class="text-light" href="mailto:princeshan031@gmail.com"><b>Prince Shankushal</b></a></span>
        </div>
    </footer>
    @* <script src="~/js/bundle.min.js"></script> *@
    <script src="~/js/bootstrap.js"></script>
    <script src="~/js/handlebars.js"></script>
    <script src="~/js/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
    <script src="~/js/chartjs-adapter-moment.js"></script>
    <script src="~/js/chartjs-plugin-zoom.js"></script>
    <script src="~/js/popper.js"></script>
    <script src="~/js/bootstrap4.5.2.min.js"></script>
    <script src="~/js/bootstrap-datepicker.js"></script>
    <script src="~/js/typed.umd.js"></script>
    <script src="~/js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script id="table-template" type="text/x-handlebars-template">
        <table id="tblSearch" class="table table-striped table-bordered table-sm table-hover">
            <thead class="thead-dark">
                <tr>
                    <th width="50" scope="col"><i class="fa fa-info"></i></th>
                    <th width="250" scope="col">Time</th>
                    <th scope="col">Event</th>
                </tr>
            </thead>
            <tbody id="table-body">
            </tbody>
        </table>
    </script>

    <script id="row-template" type="text/x-handlebars-template">
        <tr>
            <td>»</td>
            <td>{{date}}</td>
            <td>
                {{rawMessage}}
                <div>
                    {{#each tags}}
                    <span class="mr-1 badge badge-primary">{{key}} = {{value}}</span>
                    {{/each}}
                </div>
            </td>
        </tr>
    </script>

    <script>
        var enabledFilter = @(((IngestFilters)ViewData["EnabledFilter"])?.Id ?? -1);
        var chart;
        var fixedStr = "";
        // Example time span
        var timeSpan = "24h"; // Example time span
        var span = "1m";
        var chartval = "old";
        const ctx = document.getElementById('myChart');
        var guid = "";
        var startdate = "2022-03-03";
        var enddate = "2022-03-04";
        var serachCriteria = 0;

        $(document).ready(function () {
            $("#selEnabledFilter").val(enabledFilter);
            setTimeout(myFunction, 5000);
            function myFunction() {
                $(".fullscreen").hide();
            }

            var searchMode = 0;
            fixedStr = "15m";
            $("#ddSearchMode").find(".dropdown-item").click(function () {
                searchMode = parseInt($(this).data("mode"));
                fixedStr = $(this).data("val");
                $("#dropdownMenuButton").html($(this).data("text"));
                if (searchMode == 0) {
                    $('.custom-range-inputs').hide();
                }
            });

            //$('.datepicker').datepicker({
            //    format: 'yyyy-mm-dd',
            //    todayHighlight: true,
            //    autoclose: true
            //});
            var start = moment().subtract(15, 'minutes');
            var end = moment();

            $('#daterange').daterangepicker({
                startDate: start,
                "timePicker": true,
                "timePickerSeconds": true,
                endDate: end,
                ranges: {
                    'Last 15 minutes': [moment(), moment()],
                    'Last 30 minutes': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last hour': [moment().subtract(6, 'days'), moment()],
                    'Last 5 hours': [moment().subtract(29, 'days'), moment()],
                    'Last 24 hours': [moment().startOf('month'), moment().endOf('month')]
                }
            }, function (start, end, label) {
                serachCriteria = 0;
                switch (label) {
                    case "Last 15 minutes":
                        fixedStr = "15m";
                        $("#daterange").html("Last 15 minutes");
                        break;
                    case "Last 30 minutes":
                        fixedStr = "30m";
                        $("#daterange").html("Last 30 minutes");
                        break;
                    case "Last hour":
                        fixedStr = "1h";
                        $("#daterange").html("Last hour");
                        break;
                    case "Last 5 hours":
                        fixedStr = "5h";
                        $("#daterange").html("Last 5 hours");
                        break;
                    case "Last 24 hours":
                        fixedStr = "24h";
                        $("#daterange").html("Last 24 hours");
                        break;
                    default:
                        startdate = start.format("YYYY-MM-DDTHH:mm:ss");
                        enddate = end.format("YYYY-MM-DDTHH:mm:ss");
                        $("#daterange").html(startdate + " - " + enddate);
                        serachCriteria = 1;
                }
            });

            $('.custom-range').click(function () {
                $('.custom-range-inputs').toggle();
            });

            var typed = new Typed('#ele', {
                strings: ['Welcome to Intelli<b>Flo</b>'],
                typeSpeed: 30,
            });



            $("#selEnabledFilter").change(function () {
                var newVal = $("#selEnabledFilter").val();
                if (newVal == enabledFilter)
                    return;
                Swal.fire({
                    title: "Do you want to change the enabled filter?",
                    showDenyButton: true,
                    showCancelButton: true,
                    confirmButtonText: "Yes",
                    denyButtonText: `No`
                }).then((result) => {
                    /* Read more about isConfirmed, isDenied below */
                    if (result.isConfirmed) {

                        Pace.track(function () {
                            $.ajax({
                                url: "/services/values/setfilter/" + newVal,
                                type: 'GET',
                                success: function (res) {
                                    enabledFilter = newVal;
                                    Swal.fire("Changes are saved", "", "info");
                                }
                            });
                        });
                    } else if (result.isDenied) {
                        Swal.fire("Changes are not saved", "", "info");
                        $("#selEnabledFilter").val(enabledFilter);
                    }
                });
            });

            $("#btnSearchNow").click(function () {
                $("#tableDiv").html("");
                guid = createGuid();
                Pace.track(function () {
                    var data = {
                        "query": $("#taSearch").val(),
                        "fixedStr": fixedStr,
                        "requestSearchMode": searchMode,
                        "startDate": startdate,
                        "endDate": enddate,
                        "guid": guid,
                        "dateSearchCriteria": serachCriteria
                    }



                    $.ajax({
                        url: '/services/query/process',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function (response) {
                            successFunc(response);
                        },
                        error: function (xhr, status, error) {
                            // Handle any errors

                            switch (xhr.status) {
                                case 504:
                                    setTimeout(makeAjaxCall, 3000);
                            }
                        }
                    });
                });
            });
        });

        // Function to make AJAX call
        function makeAjaxCall() {
            Pace.track(function () {
                var data = {
                    "guid": guid
                }

                $.ajax({
                    url: '/services/query/processWait',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (response) {
                        // Check if flag is true
                        if (response.flag === true) {
                            successFunc(response.response);
                        } else if (response.waitMore === true) {
                            setTimeout(makeAjaxCall, 3000);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error occurred while making AJAX call:", error);
                    }
                });
            });
        }

        function newChart(datasetsData, allLabels, datasetsTemp, names) {
            if (chart != null)
                chart.destroy();

            // Example time-series data
            const labels = allLabels;
            const datasets = datasetsData; // Example datasets with data only

            // Fill missing data points
            const { filledTimeLabels, filledDatasets } = fillMissingData(labels, datasets, timeSpan, span);

            // Create dataset objects for Chart.js
            var chartDatasets = filledDatasets.map((filledData, index) => ({
                label: names[index],
                data: filledData,
                borderColor: getRandomColor(),
                fill: false,
                spanGaps: false,
                pointRadius: 0, // Hide data points by default
                hoverRadius: 4 // Show data points when hovered
            }));

            // Create Chart.js chart
            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: filledTimeLabels,
                    datasets: chartDatasets
                },
                options: {
                    plugins: {
                        zoom: {
                            pan: {
                                enabled: true,
                                mode: 'x',
                                threshold: 10,
                            },
                            zoom: {
                                drag: {
                                    enabled: true
                                }
                            }
                        }
                    },
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                //2024-04-11T00:05:18.71+05:30
                                parser: 'YYYY-MM-DDTHH:mm:ssZ',
                                tooltipFormat: 'YYYY-MM-DDTHH:mm:ssZ',
                                unit: 'minute'
                            },
                            title: {
                                display: true,
                                text: 'Time'
                            }//,
                            // ticks: {
                            //     autoSkip: false,
                            //     maxRotation: 0,
                            //     minRotation: 0,
                            //     callback: function (value, index, values) {
                            //         return index % 3 == 0 ? moment(value).format("DD MMM YY hh:mm:ss") : '';
                            //     }
                            // }
                        },
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function oldChart(datasetsData, allLabels, datasets, names) {
            // Create dataset objects for Chart.js
            var chartDatasets = datasets.map((dataset, index) => ({
                label: names[index],
                data: datasetsData[index],
                borderColor: getRandomColor(),
                fill: false,
                spanGaps: false,
            }));

            var data = {
                labels: allLabels,
                datasets: chartDatasets
            };

            if (chart != null)
                chart.destroy();

            chart = new Chart(ctx, {
                type: 'line',
                data: data,
                options: {
                    spanGaps: true,
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                //2024-04-11T00:05:18.71+05:30
                                parser: 'YYYY-MM-DDTHH:mm:ssZ',
                                tooltipFormat: 'YYYY-MM-DDTHH:mm:ssZ',
                                unit: 'minute'
                            },
                            title: {
                                display: true,
                                text: 'Time'
                            }//,
                            // ticks: {
                            //     autoSkip: false,
                            //     maxRotation: 0,
                            //     minRotation: 0,
                            //     callback: function (value, index, values) {
                            //         return index % 3 == 0 ? moment(value).format("DD MMM YY hh:mm:ss") : '';
                            //     }
                            // }
                        },
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        // Function to fill in missing data points with placeholders based on time span
        function fillMissingData(labels, datasets, timeSpan, span) {
            const filledTimeLabels = [];

            const filledDatasets = [];

            $.each(datasets, function (index, item) {
                filledDatasets.push([]);
            });
            // Calculate timezone offset
            const timezoneOffset = calculateTimezoneOffset(labels[0]);

            //const startTime = calculateStartTime(timeSpan, timezoneOffset);
            const startTime = new Date(labels[0]);
            const endTime = new Date(labels[labels.length - 1]);
            //const endTime = new Date();
            let currentTime = new Date(startTime);
            var timeformat = "";
            // Convert time span to milliseconds
            if (span.endsWith('s')) {
                interval = parseInt(span.slice(0, -1)) * 1000; // seconds to milliseconds
                timeformat = "YYYY-MM-DDTHH:mm:ss";
            } else if (span.endsWith('m')) {
                interval = parseInt(span.slice(0, -1)) * 60 * 1000; // minutes to milliseconds
                timeformat = "YYYY-MM-DDTHH:mm";
            } else if (span.endsWith('h')) {
                interval = parseInt(span.slice(0, -1)) * 60 * 60 * 1000; // hours to milliseconds
                timeformat = "YYYY-MM-DDTHH";
            } else if (span.endsWith('d')) {
                interval = parseInt(span.slice(0, -1)) * 24 * 60 * 60 * 1000; // days to milliseconds
                timeformat = "YYYY-MM-DD";
            }

            while (currentTime <= endTime) {
                const timeString = moment(currentTime).format(timeformat);
                filledTimeLabels.push(timeString);

                // Fill data for each dataset
                $.each(datasets, function (i, item) {
                    const index = labels.findIndex(l => l.startsWith(timeString));
                    var data = index !== -1 ? item[index] : null;
                    filledDatasets[i].push(data);
                });

                currentTime.setTime(currentTime.getTime() + interval); // Increment time by the interval
            }

            return { filledTimeLabels, filledDatasets };
        }


        // Function to calculate the start time based on the time span (in minutes or hours) for the provided timezone offset
        function calculateStartTime(timeSpan, timezoneOffset) {
            const currentTime = new Date();
            let startTime;

            if (timeSpan.endsWith('m')) {
                const minutes = parseInt(timeSpan.slice(0, -1));
                startTime = new Date(currentTime - minutes * 60 * 1000 - timezoneOffset);
            } else if (timeSpan.endsWith('h')) {
                const hours = parseInt(timeSpan.slice(0, -1));
                startTime = new Date(currentTime - hours * 60 * 60 * 1000 - timezoneOffset);
            } else {
                throw new Error('Invalid time span format. Please use "m" for minutes or "h" for hours.');
            }

            return startTime;
        }
        function createGuid() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }

        // Function to parse and calculate the timezone offset from the label value
        function calculateTimezoneOffset(label) {
            // Extract timezone offset from label (e.g., "+05:30")
            const timezoneOffsetString = label.slice(-6);
            const [hours, minutes] = timezoneOffsetString.split(':').map(Number);
            const timezoneOffset = (hours * 60 + minutes) * 60 * 1000; // Convert hours and minutes to milliseconds
            return timezoneOffset;
        }

        // Function to generate random color
        function getRandomColor() {
            var letters = '0123456789ABCDEF';
            var color = '#';
            for (var i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }

        var successFunc = function (response) {
            var source1 = document.getElementById("table-template").innerHTML;
            var template2 = Handlebars.compile(source1);
            $("#tableDiv").html(template2(null));

            $.each(response.lstQM, function (index, item) {
                var source = document.getElementById("row-template").innerHTML;
                var template = Handlebars.compile(source);
                var context = { date: item.date, rawMessage: item.rawMessage, tags: item.tags };

                var html = template(context);
                $("#table-body").append(html);
            });

            let table = new DataTable('#tblSearch');
            if (response.visualization != null) {

                var datasets = [];
                var names = [];

                Object.keys(response.visualization).forEach(key => {
                    names.push(key);
                    datasets.push({ labels: response.visualization[key].map(x => x.key), data: response.visualization[key].map(x => parseInt(x.value)) });
                });

                // Combine labels from all datasets
                var allLabels = [...new Set(datasets.flatMap(dataset => dataset.labels))];

                // Fill in data for each dataset using the combined labels
                var datasetsData = datasets.map(dataset => {
                    var labelIndexMap = {};
                    dataset.labels.forEach((label, index) => {
                        labelIndexMap[label] = index;
                    });
                    return allLabels.map(label => labelIndexMap[label] !== undefined ? dataset.data[labelIndexMap[label]] : null);
                });

                if (chartval == "new")
                    newChart(datasetsData, response.labels, datasets, names);
                else
                    oldChart(datasetsData, response.labels, datasets, names);
            }
        };
    </script>
</body>
</html>
